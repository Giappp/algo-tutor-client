# AlgoTutor Client — Environment Variables
# Copy this file to .env.local and fill in your values.

# Spring Boot backend base URL (include /api/v1 prefix)
# Local example: http://localhost:8080/api/v1
# Production example: https://api.example.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Judge websocket endpoint. If omitted, the app derives it from NEXT_PUBLIC_API_BASE_URL as {origin}/ws.
# Local example: http://localhost:8080/ws
# Production examples:
# - https://api.example.com/ws for SockJS over HTTPS
# - wss://api.example.com/ws if your backend exposes native websocket only
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# Set to "true" to use mock data when backend is unavailable
# Keep "false" in production.
NEXT_PUBLIC_USE_MOCK=false
