# AlgoTutor Client — Environment Variables
# Copy this file to .env.local and fill in your values.

# Browser requests stay on the FE origin so SameSite=Strict auth cookies work.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-only target used by the Next.js /api/v1 rewrite (origin only, no /api/v1 suffix).
API_PROXY_TARGET=http://localhost:8080

# Set to "true" to use mock data when backend is unavailable
# Keep "false" in production.
NEXT_PUBLIC_USE_MOCK=false
